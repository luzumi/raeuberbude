# ============================================================================
# Räuberbude Backend Environment Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# MongoDB Configuration (Legacy - wird noch für Migration verwendet)
# ----------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=rb_root
MONGO_INITDB_ROOT_PASSWORD=rb_secret
MONGO_INITDB_DATABASE=raueberbude
MONGO_URI=mongodb://rb_root:rb_secret@localhost:27018/raueberbude?authSource=admin

# ----------------------------------------------------------------------------
# MariaDB Configuration (NEU - Primary Database nach Migration)
# ----------------------------------------------------------------------------
MARIADB_HOST=localhost
MARIADB_PORT=3307
MARIADB_DATABASE=raueberbude
MARIADB_USER=rb_user
MARIADB_PASSWORD=rb_user_secret
MARIADB_ROOT_PASSWORD=rb_mariadb_secret

# ----------------------------------------------------------------------------
# API Configuration
# ----------------------------------------------------------------------------
API_PORT=3001
NEST_PORT=3001
CORS_ORIGINS=http://localhost:4200,http://localhost:4301
NODE_ENV=development

# ----------------------------------------------------------------------------
# Speech-to-Text Configuration
# ----------------------------------------------------------------------------
STT_ENABLED=true
STT_PRIMARY=vosk
STT_SECONDARY=whisper
STT_LANG=de-DE
STT_MAX_DURATION_MS=30000

# Vosk Configuration
VOSK_WS_URL=ws://localhost:2700
VOSK_PORT=2700

# Whisper Configuration
WHISPER_URL=http://localhost:9000/transcribe
WHISPER_PORT=9090
WHISPER_MODEL=small
WHISPER_LANGUAGE=de

# ----------------------------------------------------------------------------
# LLM Configuration
# ----------------------------------------------------------------------------
LLM_URLS=http://localhost:1234/v1/chat/completions
LLM_URL=http://localhost:1234/v1/chat/completions
LLM_MODEL=mistralai/mistral-7b-instruct-v0.3
LLM_FALLBACK_MODEL=
LLM_USE_GPU=true
LLM_TIMEOUT_MS=30000
LLM_TARGET_LATENCY_MS=2000
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.3
LLM_CONFIDENCE_SHORTCUT=0.85
LLM_HEURISTIC_BYPASS=false

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------
LOGS_PORT=3003

# ----------------------------------------------------------------------------
# Database Migration Flags
# ----------------------------------------------------------------------------
# Set to 'mariadb' to use MariaDB, 'mongodb' for MongoDB (during transition)
DB_PRIMARY=mariadb
DB_ENABLE_DUAL_WRITE=false

# ----------------------------------------------------------------------------
# Security & Database
# ----------------------------------------------------------------------------
DATABASE_SSL=false

