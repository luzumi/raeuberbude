# ============================================================================
# Räuberbude Backend Environment Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# MongoDB Configuration
# ----------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=rb_root
MONGO_INITDB_ROOT_PASSWORD=rb_secret
MONGO_INITDB_DATABASE=raueberbude
MONGO_URI=mongodb://rb_root:rb_secret@localhost:27018/raueberbude?authSource=admin

# ----------------------------------------------------------------------------
# API Configuration
# ----------------------------------------------------------------------------
API_PORT=3001
NEST_PORT=3001
# Production: https://yourdomain.com  (Nginx terminiert SSL, API empfängt Origin)
CORS_ORIGINS=https://localhost,http://localhost:4200
HTTPS_PORT=443
NODE_ENV=development

# ----------------------------------------------------------------------------
# Speech-to-Text Configuration
# ----------------------------------------------------------------------------
STT_ENABLED=true
STT_PRIMARY=vosk
STT_SECONDARY=whisper
STT_LANG=de-DE
STT_MAX_DURATION_MS=30000

# Vosk Configuration
VOSK_WS_URL=ws://localhost:2700
VOSK_PORT=2700

# Whisper Configuration
WHISPER_URL=http://localhost:9000/transcribe
WHISPER_PORT=9090
WHISPER_MODEL=small
WHISPER_LANGUAGE=de

# ----------------------------------------------------------------------------
# LLM Configuration
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.3
# ----------------------------------------------------------------------------
# Home Assistant Live Import
# ----------------------------------------------------------------------------
# Wenn gesetzt, holt "HA Daten neu importieren" aktuelle Daten direkt von HA
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=<long-lived-access-token>
# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------
LOGS_PORT=3003


