{
  "name": "raeuberbude-api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:network": "npm run start:dev",
    "start:prod": "node dist/main.js",
    "import:ha": "ts-node src/cli/import-ha-data.ts",
    "typeorm": "typeorm-ts-node-commonjs -d src/config/typeorm-cli.config.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:integration": "cross-env NODE_ENV=test jest --config jest.integration.config.js --runInBand",
    "test:db": "npm run test:db:setup && npm run test:integration && npm run test:db:teardown",
    "test:db:setup": "docker-compose -f docker-compose.test.yml up -d && timeout /t 5",
    "test:db:teardown": "docker-compose -f docker-compose.test.yml down -v",
    "test:db:migrate": "cross-env NODE_ENV=test npm run migration:run"
  },
  "dependencies": {
    "@nestjs/axios": "^3.0.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/mongoose": "^10.0.1",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/typeorm": "^10.0.0",
    "@types/cookie-parser": "^1.4.10",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.0",
    "mongoose": "^8.6.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.27",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.5",
    "@types/fluent-ffmpeg": "^2.1.26",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.5.10",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
