{
  "name": "raeuberbude-api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:network": "npm run start:dev",
    "start:prod": "node dist/main.js",
    "import:ha": "ts-node src/cli/import-ha-data.ts",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d src/data-source.ts",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- migration:run -d src/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/data-source.ts",
    "migrate:mongo-to-mariadb": "ts-node src/cli/migrate-mongo-to-mariadb.ts",
    "migrate:keywords-suggestions": "ts-node src/cli/migrate-keywords-suggestions.ts",
    "validate:many-to-many-migration": "ts-node src/cli/validate-many-to-many-migration.ts",
    "validate:data-types": "ts-node src/cli/validate-data-types.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^3.0.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/mongoose": "^10.0.1",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/typeorm": "^10.0.0",
    "@types/cookie-parser": "^1.4.10",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.0",
    "mongoose": "^8.6.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.5",
    "@types/fluent-ffmpeg": "^2.1.26",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.5.10",
    "jest": "^30.2.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5",
    "uuid": "^13.0.0"
  }
}
