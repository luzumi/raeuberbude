{
  "name": "raeuberbude",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "nx serve",
    "start:dev": "npx concurrently \"ng serve\" \"cd backend/nest-app && npm run start:dev\"",
    "start:network": "npx concurrently \"cd backend/nest-app && npm run start:dev\" \"cd .specify/mcp-servers && npm run all\" \"npx nx serve --host=0.0.0.0 --port=4301 --configuration=network --proxy-config=proxy.conf.json\"",
    "start:network:seq": "scripts/start-network-sequential.bat",
    "build": "nx build",
    "watch": "nx build --watch --configuration development",
    "test": "nx test --watch=false",
    "test:unit": "nx test --watch=false --code-coverage",
    "test:unit:watch": "nx test",
    "test:coverage": "nx test --watch=false --code-coverage --browsers=ChromeHeadless",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:speech": "playwright test speech",
    "test:orange-light": "playwright test orange-light",
    "test:report": "playwright show-report test-results/playwright-report",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:auto": "node .specify/scripts/auto-test-feature.js",
    "mcp:youtrack:local": "node .specify/mcp-servers/youtrack-mcp-server.js",
    "mcp:web:local": "node .specify/mcp-servers/web-mcp-server.js",
    "mcp:web:headed:win": "set MCP_HEADLESS=false&& node .specify/mcp-servers/web-mcp-server.js",
    "mcp:docker:local": "node .specify/mcp-servers/docker-mcp-server.js",
    "ha:dump": "node .specify/scripts/ha_dump.js",
    "ha:sync": "cd backend/nest-app && npm run import:ha && npm run sync:ha",
    "prepare": "husky install",
    "serve:logs": "node server/index.js",
    "serve:cert": "node scripts/serve-cert.js",
    "health": "node scripts/health-check.js",
    "check-ports": "scripts/check-ports.bat",
    "restart": "npm stop --if-present && npm start",
    "start-all": "scripts/start-all-servers.bat",
    "start:backend:legacy": "npm --prefix backend run start",
    "db:load-test": "k6 run scripts/db-load-test.js",
    "db:explain": "docker exec -i mariadb mysql -u rb_user -prb_user_secret < scripts/db-explain-queries.sql",
    "db:backup-test": "powershell -ExecutionPolicy Bypass -File scripts/db-backup-test.ps1",
    "db:monitoring": "powershell -ExecutionPolicy Bypass -File scripts/db-monitoring-setup.ps1"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.12",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.12",
    "@angular/compiler": "20.3.12",
    "@angular/core": "20.3.12",
    "@angular/forms": "20.3.12",
    "@angular/material": "20.2.14",
    "@angular/platform-browser": "20.3.12",
    "@angular/platform-browser-dynamic": "20.3.12",
    "@angular/router": "20.3.12",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "body-parser": "^2.2.1",
    "chrome-devtools-mcp": "^0.11.0",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "form-data": "^4.0.4",
    "karma-chrome-launcher": "^3.2.0",
    "mcp-n8n-builder": "^0.0.4",
    "mongoose": "^8.5.3",
    "multer": "^2.0.2",
    "ngrok": "^5.0.0-beta.2",
    "puppeteer": "^24.15.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "ws": "^8.17.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "20.3.12",
    "@angular-devkit/schematics": "20.3.12",
    "@angular/build": "20.3.12",
    "@angular/cli": "20.3.12",
    "@angular/compiler-cli": "20.3.12",
    "@nx/angular": "22.3.1",
    "@nx/workspace": "22.3.1",
    "@playwright/test": "^1.56.0",
    "@schematics/angular": "20.3.12",
    "@types/jasmine": "~5.1.0",
    "axios": "^1.13.2",
    "husky": "^8.0.0",
    "jasmine-core": "~5.7.0",
    "jsdom": "^24.0.0",
    "k6": "^0.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-firefox-launcher": "^2.1.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "karma-jsdom-launcher": "^18.0.0",
    "node-fetch": "^2.7.0",
    "nx": "22.3.1",
    "puppeteer": "^24.15.0",
    "typescript": "~5.8.2"
  },
