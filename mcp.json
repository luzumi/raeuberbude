{
    "mcpServers": {
        "lmStudio": {
            "command": "node",
            "args": [
                ".specify/mcp-servers/lm-studio-mcp-server.js"
            ],
            "env": {
                "LM_STUDIO_URL": "http://127.0.0.1:1234"
            }
        },
        "perplexity": {
            "command": "npx",
            "args": [
                "-y",
                "@perplexity-ai/mcp-server"
            ],
            "env": {
                "PERPLEXITY_API_KEY": ""
            }
        },
        "mariaDB": {
            "command": "node",
            "args": [
                ".specify/mcp-servers/maria-mcp-server.js"
            ],
            "env": {
                "DB_HOST": "127.0.0.1",
                "DB_PORT": "3306",
                "DB_USER": "app_user",
                "DB_PASSWORD": "secret",
                "DB_DATABASE": "raeuberbude",
                "PORT": "3001"
            }
        }
    }
}
